generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  PERSONAL
  STUDENT
}

enum StudentLevel {
  INICIANTE
  MODERADO
  AVANCADO
}

enum PaymentStatus {
  PAID
  PENDING
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  password      String
  role          UserRole  @default(STUDENT)
  avatarUrl     String?
  phone         String?
  mustChangePassword Boolean @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Personal trainer -> students
  students      Student[] @relation("PersonalTrainer")
  managedWorkouts Workout[]
  managedDiets    DietPlan[]
  workoutTemplates WorkoutTemplate[]
  dietTemplates    DietTemplate[]
  weekTemplates    WeekTemplate[]

  // Student -> trainer (self-referential)
  trainerId     String?
  myTrainer     User?     @relation("TrainerOf", fields: [trainerId], references: [id])
  myStudents    User[]    @relation("TrainerOf")

  // Student record linked to this login account
  studentRecord Student?  @relation("StudentAccount")

  // Programa de indicacao (mensalidade)
  referralCode          String? @unique
  referredByUserId      String?
  referredByUser        User?   @relation("ReferredBy", fields: [referredByUserId], references: [id], onDelete: SetNull)
  myReferrals           User[]  @relation("ReferredBy")
  referralDiscountMonths Int     @default(0)

  // Planos e faturamento
  isActive  Boolean   @default(true)
  lifetime  Boolean   @default(false)
  paidUntil DateTime?

  // Plano do PERSONAL: limite de alunos + valor mensal (aluno acessa gratis)
  studentLimit Int @default(10)
  monthlyPrice Int @default(22)

  notifications Notification[]
  payments     Payment[] @relation("UserPayments")
}

model Student {
  id        String  @id @default(cuid())
  name      String
  email     String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Periodo da reavaliacao (ex.: 30 dias).
  reviewFrequencyDays Int @default(30)

  personalId String?
  personal   User?   @relation("PersonalTrainer", fields: [personalId], references: [id])

  // Vínculo com a conta de login do aluno
  userId String? @unique
  user   User?   @relation("StudentAccount", fields: [userId], references: [id])

  workouts     Workout[]
  dietPlans    DietPlan[]
  progressLogs ProgressLog[]
  sessions     WorkoutSession[]
  mealLogs     MealLog[]
  restDays     RestDay[]

  @@unique([email, personalId])
}

model RestDay {
  id        String   @id @default(cuid())
  studentId String
  weekday   String
  createdAt DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, weekday])
}

model Workout {
  id          String   @id @default(cuid())
  name        String
  description String?
  dayLetter   String
  dayOfWeek   String?
  isActive    Boolean  @default(true)
  autoAdvance Boolean  @default(false)
  deadlineDays Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  trainerId String
  trainer   User    @relation(fields: [trainerId], references: [id])

  exercises  WorkoutExercise[]
  sessions   WorkoutSession[]
}

model Exercise {
  id          String  @id @default(cuid())
  name        String
  muscleGroup String
  gifUrl      String?
  description String?

  workoutExercises WorkoutExercise[]
  workoutTemplates WorkoutTemplateExercise[]
  completedExercises CompletedExercise[]
}

model WorkoutExercise {
  id            String  @id @default(cuid())
  order         Int
  sets          Int     @default(3)
  reps          String
  initialLoad   String?
  restTime      Int     @default(60)
  notes         String?
  // Exercicio alternativo/semelhante caso o aluno nao tenha a maquina
  alternative   String?

  workoutId   String
  workout     Workout @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exerciseId  String
  exercise    Exercise @relation(fields: [exerciseId], references: [id])
}

model WorkoutTemplate {
  id          String   @id @default(cuid())
  name        String
  description String?
  level       StudentLevel @default(INICIANTE)
  isPreset    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  trainerId String?
  trainer   User?   @relation(fields: [trainerId], references: [id], onDelete: SetNull)

  exercises WorkoutTemplateExercise[]
  weekDays  WeekTemplateDay[]
}

model WorkoutTemplateExercise {
  id          String  @id @default(cuid())
  order       Int
  sets        Int     @default(3)
  reps        String
  initialLoad String?
  restTime    Int     @default(60)
  notes       String?

  workoutTemplateId String
  workoutTemplate   WorkoutTemplate @relation(fields: [workoutTemplateId], references: [id], onDelete: Cascade)

  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id])
}

model WeekTemplate {
  id          String   @id @default(cuid())
  name        String
  description String?
  level       StudentLevel @default(INICIANTE)
  isPreset    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  trainerId String?
  trainer   User?   @relation(fields: [trainerId], references: [id], onDelete: SetNull)

  days WeekTemplateDay[]
}

model WeekTemplateDay {
  id             String @id @default(cuid())
  weekday        String
  workoutTemplateId String?
  workoutTemplate   WorkoutTemplate? @relation(fields: [workoutTemplateId], references: [id], onDelete: SetNull)

  weekTemplateId String
  weekTemplate   WeekTemplate @relation(fields: [weekTemplateId], references: [id], onDelete: Cascade)

  @@unique([weekTemplateId, weekday])
}

model DietTemplate {
  id          String   @id @default(cuid())
  name        String
  description String?
  level       StudentLevel @default(INICIANTE)
  isPreset    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  dailyProtein    Float?
  dailyCarbs      Float?
  dailyFat        Float?
  dailyCalories   Float?
  waterIntake     String?
  supplementation String?

  trainerId String?
  trainer   User?   @relation(fields: [trainerId], references: [id], onDelete: SetNull)

  meals DietTemplateMeal[]
}

model DietTemplateMeal {
  id     String @id @default(cuid())
  time   String
  name   String
  order  Int

  dietTemplateId String
  dietTemplate   DietTemplate @relation(fields: [dietTemplateId], references: [id], onDelete: Cascade)

  foods DietTemplateFood[]
}

model DietTemplateFood {
  id       String @id @default(cuid())
  name     String
  quantity String
  protein  Float?
  carbs    Float?
  fat      Float?
  calories Float?

  mealId String
  meal   DietTemplateMeal @relation(fields: [mealId], references: [id], onDelete: Cascade)
}

model WorkoutSession {
  id        String   @id @default(cuid())
  date      DateTime @default(now())
  completed Boolean  @default(false)
  notes     String?

  workoutId String
  workout   Workout @relation(fields: [workoutId], references: [id], onDelete: Cascade)

  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  completedExercises CompletedExercise[]
}

model CompletedExercise {
  id          String @id @default(cuid())
  setNumber   Int
  reps        Int
  load        String?
  completed   Boolean @default(false)

  sessionId   String
  session     WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  exerciseId  String
  exercise    Exercise @relation(fields: [exerciseId], references: [id])
}

model DietPlan {
  id          String   @id @default(cuid())
  name        String
  description String?
  startDate   DateTime?
  endDate     DateTime?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  dailyProtein    Float?
  dailyCarbs      Float?
  dailyFat        Float?
  dailyCalories   Float?
  waterIntake     String?
  supplementation String?

  studentId  String
  student    Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  trainerId String
  trainer   User    @relation(fields: [trainerId], references: [id])

  meals Meal[]
  mealLogs MealLog[]
}

model Meal {
  id     String @id @default(cuid())
  time   String
  name   String
  order  Int
  dayOfWeek String?

  dietPlanId String
  dietPlan   DietPlan @relation(fields: [dietPlanId], references: [id], onDelete: Cascade)

  foods MealFood[]
  logs  MealLog[]
}

model MealFood {
  id       String @id @default(cuid())
  name     String
  quantity String
  protein  Float?
  carbs    Float?
  fat      Float?
  calories Float?

  mealId String
  meal   Meal @relation(fields: [mealId], references: [id], onDelete: Cascade)
}

model ProgressLog {
  id        String   @id @default(cuid())
  date      DateTime @default(now())
  weight    Float?
  bodyFat   Float?
  chest     Float?
  waist     Float?
  arm       Float?
  thigh     Float?
  notes     String?
  photoUrl  String?

  studentId String
  student   Student @relation(fields: [studentId], references: [id])
}

model Notification {
  id        String   @id @default(cuid())
  type      String
  read      Boolean  @default(false)
  data      Json?
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Payment {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation("UserPayments", fields: [userId], references: [id], onDelete: Cascade)
  amount    Int           @default(22)
  status    PaymentStatus @default(PENDING)
  reference String?
  paidAt    DateTime?
  createdAt DateTime      @default(now())

  @@index([userId, createdAt])
}

model MealLog {
  id         String   @id @default(cuid())
  date       DateTime @default(now())

  mealId     String
  meal       Meal     @relation(fields: [mealId], references: [id], onDelete: Cascade)

  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  dietPlanId String
  dietPlan   DietPlan @relation(fields: [dietPlanId], references: [id], onDelete: Cascade)

  @@index([studentId, date])
}
