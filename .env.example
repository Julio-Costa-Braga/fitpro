# FitPro - variaveis de ambiente (exemplo). Copie para .env e preencha.
# NUNCA commite valores reais.

DATABASE_URL="postgresql://USUARIO:SENHA@HOST/DB?sslmode=require"
JWT_SECRET="troque-por-um-segredo-longo-e-aleatorio"

# Web Push (VAPID) - gere um par novo com: node -e "console.log(require('web-push').generateVAPIDKeys())"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:contato@fitpro.app"

# URL base usada em ambientes de dev/preview
NEXT_PUBLIC_APP_URL="http://localhost:3000"